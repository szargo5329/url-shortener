# Environment variables for the frontend. Copy the relevant file and fill in
# values; never commit real .env / .env.development files.
#
# Vite loads these by mode:
#   .env.development — used by `npm run dev`   (gitignored)
#   .env.production  — used by `npm run build` (committed; contains no secrets)

# Base URL the app prefixes onto API calls (e.g. `${VITE_API_BASE_URL}/shorten`).
#
# Development: set to the dev-server proxy path so requests stay same-origin and
# avoid CORS (the backend only allows the CloudFront origin):
#   VITE_API_BASE_URL=/api
#
# Production: set to the API Gateway invoke URL, no trailing slash. Get it with:
#   terraform -chdir=infrastructure output -raw api_gateway_invoke_url
VITE_API_BASE_URL=
